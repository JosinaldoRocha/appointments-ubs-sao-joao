rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Novo caminho usado no app: solicitacoes-whatsapp/<id>_<arquivo>
    match /solicitacoes-whatsapp/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 6 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Legado (se houver links antigos em mensagens WhatsApp)
    match /whatsapp_agenda_docs/{name} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /solicitacoes_docs/{name} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
  }
}

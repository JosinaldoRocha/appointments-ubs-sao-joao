rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isLoggedIn() {
      return request.auth != null;
    }
    // Papel do usuário no documento `usuarios`: campo `rule` (aceita `role` legado).
    function getRole() {
      let d = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return d.rule != null ? d.rule : d.role;
    }
    function isRecepcao() {
      let r = getRole();
      return isLoggedIn() && (
        r == "recepcao" ||
        r == "Recepcao" ||
        r == "RECEPCAO" ||
        r == "recepcionista" ||
        r == "Recepcionista" ||
        r == "RECEPCIONISTA" ||
        r == "recepção" ||
        r == "Recepção" ||
        r == "RECEPÇÃO"
      );
    }
    function isDiretor() {
      let r = getRole();
      return isLoggedIn() && (
        r == "diretor" ||
        r == "Diretor" ||
        r == "DIRETOR" ||
        r == "direção" ||
        r == "Direção" ||
        r == "DIREÇÃO"
      );
    }
    function isAgente() {
      let r = getRole();
      return isLoggedIn() && (r == "agente" || r == "Agente" || r == "AGENTE");
    }
    function isAgenteOuDiretor() {
      return isAgente() || isDiretor();
    }
    /** Agente/direção: atualizações restritas em `vagas` (reserva de solicitação / confirmação). */
    function agentVagaSoReservaSolicitacao() {
      let r = resource.data;
      let n = request.resource.data;
      return n.used == r.used
        && n.reserved == r.reserved
        && n.total == r.total
        && n.atendimentoDate == r.atendimentoDate
        && n.specKey == r.specKey
        && n.sessIdx == r.sessIdx
        && n.dayKey == r.dayKey
        && n.reservaSolicitacao.uid == request.auth.uid;
    }
    function agentVagaLiberarReservaSolicitacao() {
      let r = resource.data;
      let n = request.resource.data;
      return n.used == r.used
        && n.reserved == r.reserved
        && n.total == r.total
        && !("reservaSolicitacao" in n)
        && r.get("reservaSolicitacao", null) != null
        && r.reservaSolicitacao.uid == request.auth.uid;
    }
    function agentVagaConfirmarSolicitacao() {
      let r = resource.data;
      let n = request.resource.data;
      return n.used == r.used + 1
        && n.reserved == r.reserved
        && n.total == r.total
        && !("reservaSolicitacao" in n)
        && r.get("reservaSolicitacao", null) != null
        && r.reservaSolicitacao.uid == request.auth.uid
        && n.used + n.reserved <= n.total;
    }
    function agentVagaConfirmarSemReserva() {
      let r = resource.data;
      let n = request.resource.data;
      return n.used == r.used + 1
        && n.reserved == r.reserved
        && n.total == r.total
        && n.atendimentoDate == r.atendimentoDate
        && n.specKey == r.specKey
        && n.sessIdx == r.sessIdx
        && n.dayKey == r.dayKey
        && !("reservaSolicitacao" in n)
        && r.get("reservaSolicitacao", null) == null
        && r.used + r.reserved < r.total
        && n.used + n.reserved <= n.total;
    }
    function agentVagaCreateInicialReserva() {
      let n = request.resource.data;
      return n.used == 0
        && n.reserved == 0
        && n.total is number && n.total > 0 && n.total <= 200
        && n.reservaSolicitacao.uid == request.auth.uid;
    }
    // Lista de espera: agentes, direção e recepção (recepção opera pela aba Vagas)
    function podeCriarEspera() {
      return isLoggedIn() && (isAgente() || isRecepcao() || isDiretor());
    }

    // Usuários: lê o próprio perfil; recepção lê/escreve todos
    match /usuarios/{uid} {
      allow read:   if isLoggedIn() && (request.auth.uid == uid || isRecepcao() || isDiretor());
      allow write:  if isRecepcao();
      allow update: if isLoggedIn() && request.auth.uid == uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fcmTokens"]);
    }

    // Profissionais: todos leem; só recepção edita
    match /profissionais/{id} {
      allow read:  if isLoggedIn();
      allow write: if isRecepcao();
    }

    // Vagas: recepção altera livremente; agente/direção só reserva/libera/confirma solicitação
    match /vagas/{id} {
      allow read:  if isLoggedIn();
      allow delete: if isRecepcao();
      allow create: if isRecepcao()
        || (isAgenteOuDiretor() && agentVagaCreateInicialReserva());
      allow update: if isRecepcao()
        || (isAgenteOuDiretor() && (
          agentVagaSoReservaSolicitacao()
          || agentVagaLiberarReservaSolicitacao()
          || agentVagaConfirmarSolicitacao()
          || agentVagaConfirmarSemReserva()
        ));
    }

    // Lista de espera: agentes criam; recepção remove
    match /listaEspera/{id} {
      allow read:   if isLoggedIn();
      allow create: if podeCriarEspera();
      allow delete: if isRecepcao();
    }

    // Notificações pendentes: recepção cria livremente; agente/direção só aviso de vagas esgotadas
    match /notificacoesPendentes/{id} {
      allow read:   if isRecepcao() || isDiretor();
      allow create: if isRecepcao()
        || (isAgenteOuDiretor()
          && request.resource.data.tipo == "vagas_esgotadas"
          && request.resource.data.processado == false
          && request.resource.data.keys().hasAll(["tipo", "specKey", "specNome", "criadoEm", "processado"]));
      allow update: if false; // só a Cloud Function atualiza
      allow delete: if false;
    }

    // Configuração global (feriados, Fernando, PCCU): todos leem; recepção edita
    match /settings/{id} {
      allow read:  if isLoggedIn();
      allow write: if isRecepcao();
    }

  }
}
